# ==============================================================================
# Owtlet NestJS Backend Dockerfile (infrastructure/docker/Dockerfile.backend)
# Multi-stage production build for NestJS 10+ REST API & Prisma ORM
# ==============================================================================
FROM node:20-alpine AS base

# Install libc6-compat and openssl for Prisma
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 1: Dependencies
# ------------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app

COPY package*.json pnpm-lock.yaml* ./
COPY prisma ./prisma/

# Install pnpm and dependencies
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --frozen-lockfile || npm ci

# ------------------------------------------------------------------------------
# Stage 2: Builder
# ------------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma Client & compile NestJS application
RUN npx prisma generate
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm run build || npm run build

# ------------------------------------------------------------------------------
# Stage 3: Runner
# ------------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Security: Non-root user
RUN addgroup --system --gid 1001 nestjs
RUN adduser --system --uid 1001 nestjs

# Copy compiled artifacts, prisma schemas, and node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma

USER nestjs

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/api/health || exit 1

CMD ["node", "dist/main.js"]

