# ==============================================================================
# Owtlet — environment template (single Next.js app: UI + /api + Prisma)
#
# 1. cp .env.example .env            (never commit .env)
# 2. Fill the secrets below (generate with: openssl rand -base64 48)
# 3. bash scripts/sync-env.sh        (copies root .env -> development/frontend/.env)
#
# Production: same keys in /opt/owtlet/.env on the client VPS (docs/12-deployment-plan.md).
# ==============================================================================

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL (used for absolute links, confirmation links, emails). Prod: https://owtlet.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Owtlet"
# Store hours / show times are evaluated in this zone
APP_TIMEZONE=America/New_York

# ------------------------------------------------------------------------------
# Database (PostgreSQL 15+ via Prisma) — matches infrastructure/docker/docker-compose.yml
# ------------------------------------------------------------------------------
POSTGRES_USER=owtlet
POSTGRES_PASSWORD=owtlet
POSTGRES_DB=owtlet
DATABASE_URL=postgresql://owtlet:owtlet@localhost:5432/owtlet?schema=public

# Optional Redis (cart TTL mirror / rate limiting). Leave empty to use PostgreSQL only.
REDIS_URL=

# ------------------------------------------------------------------------------
# Secrets (HMAC keys — 32+ random bytes each, different per environment)
# ------------------------------------------------------------------------------
# owt_age cookie (21+ attestation)
AGE_COOKIE_SECRET=change_me_age_cookie_secret_min_32_chars
# owt_admin session cookie (Owtlet admins)
ADMIN_SESSION_SECRET=change_me_admin_session_secret_min_32_chars
# owt_shopper session cookie (optional shopper profiles, REQ-F-014)
SHOPPER_SESSION_SECRET=change_me_shopper_session_secret_min_32_chars
# Signed store-confirmation links (GET /api/webhooks/store-confirmation?token=...)
# Per-dispensary webhook HMAC secrets are generated in admin and stored in the DB (Dispensary.webhookSecret).
CONFIRMATION_LINK_SECRET=change_me_confirmation_link_secret_min_32_chars
# Salt for hashing IPs in AgeVerificationSession (rate limiting only)
IP_HASH_SALT=change_me_ip_hash_salt

# First admin user created by `prisma db seed`
SEED_ADMIN_EMAIL=ops@owtlet.com
SEED_ADMIN_PASSWORD=change_me_admin_password_min_12_chars

# ------------------------------------------------------------------------------
# Terrific live shopping SDK v2 (client-side, public values)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TERRIFIC_STORE_ID=BX2hWAVam9JjsFhXP5ZF
NEXT_PUBLIC_TERRIFIC_EMBEDDING_ID=Cki70GhqvLgWGhJbSxg2
NEXT_PUBLIC_TERRIFIC_SDK_URL=https://terrific.live/terrific-sdk.js

# ------------------------------------------------------------------------------
# Transactional email — password reset for optional shopper profiles (pending Q-006)
# Leave empty in dev: reset links are logged to the server console instead.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Owtlet <no-reply@owtlet.com>"

# ------------------------------------------------------------------------------
# Cannabis checkout handoff — Leafly (pending Q-001). Retailer order pages need no env
# (per-dispensary handoffUrlTemplate in admin).
# ------------------------------------------------------------------------------
LEAFLY_API_BASE_URL=
LEAFLY_API_KEY=
